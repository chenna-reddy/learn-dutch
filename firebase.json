{
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "/api/token",
        "function": { "functionId": "getSpeechToken", "region": "europe-west3" }
      },
      {
        "source": "/api/translate",
        "function": { "functionId": "translateWord", "region": "europe-west3" }
      },
      {
        "source": "/api/translate-sentence",
        "function": { "functionId": "translateSentence", "region": "europe-west3" }
      },
      { "source": "**", "destination": "/index.html" }
    ],
    "headers": [
      {
        "source": "/api/token",
        "headers": [{ "key": "Cache-Control", "value": "no-store" }]
      },
      {
        "source": "/index.html",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
      },
      {
        "source": "**/*.@(js|css|svg|png|jpg|jpeg|webp|woff2)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs22",
      "ignore": ["node_modules", ".git", "*.log"]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
